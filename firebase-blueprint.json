{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and business configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "businessName": { "type": "string" },
        "tagline": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountName": { "type": "string" },
        "preferredCurrency": { "type": "string" },
        "defaultPaymentTermsDays": { "type": "number" },
        "defaultTaxRate": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "User invoice entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "issueDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "taxRate": { "type": "number" },
        "taxAmount": { "type": "number" },
        "discountRate": { "type": "number" },
        "discountAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "currency": { "type": "string" },
        "notes": { "type": "string" },
        "paymentTerms": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "invoiceNumber", "customerName", "totalAmount", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact & credit record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "address": { "type": "string" },
        "creditScore": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name"]
    },
    "ReminderLog": {
      "title": "ReminderLog",
      "description": "Reminder dispatch history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "channel": { "type": "string" },
        "tone": { "type": "string" },
        "message": { "type": "string" },
        "sentAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "invoiceId", "channel", "sentAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User business profile data"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices belonging to user"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customers belonging to user"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": "ReminderLog",
      "description": "Dispatched reminder records"
    }
  }
}
